APP_NAME=Vixeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Appli web Vixeo (Flutter web, vixeo_frontend) : la page <WEB_URL>/tv valide la connexion d'une
# TV par QR code. Le site de présentation renvoie aussi vers elle (« Ouvrir dans le navigateur »).
WEB_URL=http://localhost:8080

# Un seul projet pour l'API et le site de présentation, distingués par le domaine
# (config/vixeo.php, docs/deploiement.md). Vides en local : un seul hôte, le site sur /, l'API
# sur /api/v1. En production : API_DOMAIN=api.vixeo.app, SITE_DOMAIN=www.vixeo.app,
# SITE_URL=https://www.vixeo.app (vixeo.app → www : redirection du site Forge).
API_DOMAIN=
SITE_DOMAIN=
# Adresse publique du site (liens canoniques, sitemap, page de mise à jour). Vide : APP_URL.
SITE_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production : PostgreSQL. En local, sqlite fonctionne aussi (DB_CONNECTION=sqlite).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vixeo
DB_USERNAME=vixeo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API tokens expire after this many minutes (default 180 days, 0 = never).
SANCTUM_EXPIRATION=259200

# App updates (docs/mise-a-jour.md): where installed apps send people to update.
# No Play Store: by default the site's install page (SITE_URL/installer#android).
ANDROID_UPDATE_URL=
# Android releases published by the app's CI (tag android-<build>); empty = table only.
APP_UPDATES_GITHUB_REPOSITORY=davybrieu/vixeo_frontend
IOS_UPDATE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Origines autorisées pour le Flutter web (séparées par des virgules).
# Exemple : https://vixeo.app,https://staging.vixeo.app
CORS_ALLOWED_ORIGINS=http://localhost:8080

API_VERSION=1.0.0

# TMDb : jeton « API Read Access Token » (recommandé) ou clé v3.
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR
# Page where a person approves Vixeo on their TMDb account (docs/compte-tmdb.md).
TMDB_AUTHENTICATE_URL=https://www.themoviedb.org/authenticate

# Sous-titres (docs/lecture.md) : clé Vixeo OpenSubtitles, compte facultatif.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT="Vixeo v1.0"
# Moments à passer (TheIntroDB) : clé facultative.
THEINTRODB_API_KEY=

# Site de présentation : rendu côté serveur (SSR), `php artisan inertia:start-ssr` après
# `npm run build`. Sans serveur SSR, les pages sont rendues dans le navigateur.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Site de présentation (config/vixeo.php). Pas de Play Store : l'APK vient de la dernière release
# GitHub android-<build> (APP_UPDATES_GITHUB_REPOSITORY) ; secours :
VIXEO_ANDROID_APK_URL=
VIXEO_ANDROID_APK_SHA256=
# Mentions légales (une valeur vide masque la ligne ; entre guillemets s'il y a des espaces)
VIXEO_PUBLISHER_NAME=
VIXEO_PUBLISHER_ADDRESS=
VIXEO_PUBLISHER_REGISTRATION=
VIXEO_PUBLICATION_DIRECTOR=
VIXEO_CONTACT_EMAIL=
VIXEO_HOST_NAME=
VIXEO_HOST_ADDRESS=
VIXEO_HOST_PHONE=

# Node scraper (Playwright) for stream sources.
SCRAPER_URL=http://127.0.0.1:3100
SCRAPER_TIMEOUT=45

# Live TV — stream proxy. Media is served from our own origin so the app always plays an HTTPS
# URL, even when the provider only offers plain HTTP. Provider URL and headers stay server-side.
TV_PROXY_TTL=21600
TV_PROXY_TIMEOUT=20
# Live TV — personal legal Xtream Codes panel (credentials stay on the server only).
# Example: XTREAM_BASE_URL=http://panel.example.com:8080
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=
# m3u8 (HLS) or ts
XTREAM_STREAM_FORMAT=m3u8
XTREAM_TIMEOUT=20
XTREAM_TTL_CATEGORIES=3600
XTREAM_TTL_CHANNELS=1800

# Live TV — Vavoo (MediaHubMX API). Mirrors and the signature stay on the server only.
# VAVOO_BASE_URLS=https://vavoo.net,https://vavoo.to,https://kool.ws,https://vavoo.top
# VAVOO_PING_URLS=https://www.vypn.net/api/app/ping,https://www.lokke.app/api/app/ping,https://www.vavoo.tv/api/app/ping
VAVOO_COUNTRY=France
VAVOO_TIMEOUT=20
VAVOO_MAX_STREAMS=3
VAVOO_TTL_SIGNATURE=300
VAVOO_TTL_CATALOG=1800
