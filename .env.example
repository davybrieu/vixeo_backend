APP_NAME=Vixeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Appli web Vixeo : la page <WEB_URL>/tv valide la connexion d'une TV par QR code.
WEB_URL=http://localhost:8080
# Site de présentation (vixeo_web) : page d'installation de l'APK Android (/installer).
SITE_URL=http://localhost:8100

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production : PostgreSQL. En local, sqlite fonctionne aussi (DB_CONNECTION=sqlite).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vixeo
DB_USERNAME=vixeo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API tokens expire after this many minutes (default 180 days, 0 = never).
SANCTUM_EXPIRATION=259200

# App updates (docs/mise-a-jour.md): where installed apps send people to update.
# No Play Store: by default the site's install page (SITE_URL/installer#android).
ANDROID_UPDATE_URL=
IOS_UPDATE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Origines autorisées pour le Flutter web (séparées par des virgules).
# Exemple : https://vixeo.app,https://staging.vixeo.app
CORS_ALLOWED_ORIGINS=http://localhost:8080

API_VERSION=1.0.0

# TMDb : jeton « API Read Access Token » (recommandé) ou clé v3.
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR

# Sous-titres (docs/lecture.md) : clé Vixeo OpenSubtitles, compte facultatif.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT="Vixeo v1.0"
# Moments à passer (TheIntroDB) : clé facultative.
THEINTRODB_API_KEY=

# Node scraper (Playwright) for stream sources.
SCRAPER_URL=http://127.0.0.1:3100
SCRAPER_TIMEOUT=45
