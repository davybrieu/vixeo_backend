APP_NAME=Vixeo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Adresse de l'API Laravel (routes sous /api/v1).
APP_URL=http://localhost:8000
API_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production : PostgreSQL. En local, sqlite fonctionne aussi (DB_CONNECTION=sqlite).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vixeo
DB_USERNAME=vixeo
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Messagerie en temps réel : Reverb, derrière le Nginx de l'API (wss://api.vixeo.app/app/{clé}), docs/reverb.md.
# Sans clé, la messagerie marche sans temps réel (les applis relisent les conversations).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=api.vixeo.app
REVERB_PORT=443
REVERB_SCHEME=https
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API tokens expire after this many minutes (default 180 days, 0 = never).
SANCTUM_EXPIRATION=259200

# App updates (docs/mise-a-jour.md): destination shown when an app update is available.
# The Flutter app is hosted at VIXEO_APP_URL; no website is served by this API.
ANDROID_UPDATE_URL=
# Android and Windows releases published by the app's CI (tags android-<build>, windows-<build>).
APP_UPDATES_GITHUB_REPOSITORY=davybrieu/vixeo_frontend
IOS_UPDATE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Origines autorisées pour le Flutter Web (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:8080

API_VERSION=1.0.0

# TMDb : jeton « API Read Access Token » (recommandé) ou clé v3.
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR

# Notes IMDb (docs/notes.md) : jeux de données importés chaque jour par `php artisan imdb:import`.
IMDB_DATASETS_URL=https://datasets.imdbws.com

# Sous-titres (docs/lecture.md) : clé Vixeo OpenSubtitles, compte facultatif.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_USER_AGENT="Vixeo v1.0"
# Moments à passer (TheIntroDB) : clé facultative.
THEINTRODB_API_KEY=

# Notifications push (Firebase Cloud Messaging, docs/notifications.md) : clé du compte de service
# du projet Firebase, chemin du fichier JSON (hors du dépôt) ou "base64:<JSON en base64>".
# Vide : pas de notification.
FCM_CREDENTIALS=

# « Continuer avec Google / Apple » (docs/connexion-sociale.md). Vide : pas encore disponible.
# Google : client OAuth « Application Web », URI de redirection
# {API_URL}/api/v1/auth/social/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : Services ID, équipe, clé « Sign in with Apple » (id + fichier .p8 hors du dépôt,
# chemin ou "base64:<contenu en base64>"), URL de retour {API_URL}/api/v1/auth/social/apple/callback.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# URL de l'application Flutter (liens de partage des profils, hébergée séparément de l'API).
VIXEO_APP_URL=https://vixeo.app

VIXEO_CONTACT_EMAIL=

# Live TV — stream proxy. Media is served from our own origin so the app always plays an HTTPS
# URL, even when the provider only offers plain HTTP. Provider URL and headers stay server-side.
TV_PROXY_TTL=21600
TV_PROXY_TIMEOUT=20
# Live TV — programme guide (EPG) and channel logos: XMLTV files (.xml or .xml.gz), comma-separated,
# the preferred first, downloaded every 6 hours by `php artisan tv:epg`. Empty = no guide.
# Check each source's terms of use.
TV_EPG_URLS="https://epg.pw/xmltv/epg_FR.xml.gz,https://i.mjh.nz/Plex/fr.xml.gz,https://i.mjh.nz/PlutoTV/fr.xml.gz,https://i.mjh.nz/SamsungTVPlus/fr.xml.gz"
TV_EPG_TTL=43200
TV_EPG_TIMEOUT=120
# Logo library (GitHub repository of TV logos, read once a day). Empty = no library.
TV_LOGOS_REPOSITORY=tv-logo/tv-logos
TV_LOGOS_DIRECTORIES=countries/france,countries/belgium,countries/switzerland,countries/international
# Live TV — personal legal Xtream Codes panel (credentials stay on the server only).
# Example: XTREAM_BASE_URL=http://panel.example.com:8080
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=
# m3u8 (HLS) or ts
XTREAM_STREAM_FORMAT=m3u8
XTREAM_TIMEOUT=20
XTREAM_TTL_CATEGORIES=3600
XTREAM_TTL_CHANNELS=1800

# Live TV — Vavoo (MediaHubMX API). Mirrors and the signature stay on the server only.
# VAVOO_BASE_URLS=https://vavoo.net,https://vavoo.to,https://kool.ws,https://vavoo.top
# VAVOO_PING_URLS=https://www.vypn.net/api/app/ping,https://www.lokke.app/api/app/ping,https://www.vavoo.tv/api/app/ping
VAVOO_COUNTRY=France
VAVOO_TIMEOUT=20
VAVOO_MAX_STREAMS=3
VAVOO_TTL_SIGNATURE=300
VAVOO_TTL_CATALOG=1800

# Additional title ratings (MDBList), loaded only when opening the ratings modal.
MDBLIST_API_KEY=
MDBLIST_DAILY_REQUESTS=900
